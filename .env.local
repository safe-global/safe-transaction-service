PYTHONPATH=/app/
DJANGO_SETTINGS_MODULE=config.settings.local
DEBUG=0
DATABASE_URL=psql://postgres:postgres@db:5432/postgres
ETHEREUM_NODE_URL=http://172.17.0.1:8545
ETHEREUM_TRACING_NODE_URL=http://172.17.0.1:8545
ETH_L2_NETWORK=0
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq/
# Index `SafePolicyGuard` events. Also requires a known guard deployment for the chain. Default true.
POLICIES_ENABLE_INDEXING=true
# Expose the policy endpoints under /api/v2. Default true.
POLICIES_ENABLE_API=true
